<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The tray context menu crash investigated 2026-08-02/03 turned out to be unrelated to
         UseWPF or DPI mode: see TrayApplicationContext.WaitForHomeAssistantConnectionThenRefreshAsync's
         doc for the confirmed root cause (a ConfigureAwait(false) chain resuming a menu-mutating
         Home Assistant startup refresh on a thread-pool thread instead of the UI thread). A second,
         separate intermittent issue in the same area (the tray menu's internal scroll-arrow control
         occasionally failing Win32 CreateWindowEx, and — later in the same investigation — right-
         clicks sometimes not reaching the icon at all) was NOT resolved; Home Assistant defaults to
         disabled (see MonitorConfig.HomeAssistantConfig.Enabled) until that's root-caused, since it
         was the trigger for the confirmed bug and its menu content is the most complex part of the
         tray UI. UseWPF stays: BaballoniaAutomation (Modules/EyeTracking.cs) needs
         System.Windows.Automation, which UseWPF supplies. SystemAware DPI mode kept since a
         tray-only app with no resizable Form has no use for PerMonitorV2's added complexity. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Gates the entire Home Assistant lights feature (see docs/superpowers/specs/2026-07-26-home-assistant-lights-design.md).
         Override with `dotnet build -p:IncludeHomeAssistant=false` to compile it — and its two
         extra NuGet dependencies — out entirely. -->
    <IncludeHomeAssistant Condition="'$(IncludeHomeAssistant)'==''">true</IncludeHomeAssistant>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeHomeAssistant)'=='true'">
    <DefineConstants>$(DefineConstants);INCLUDE_HOME_ASSISTANT</DefineConstants>
  </PropertyGroup>

  <!-- UseWPF changes the SDK's default implicit-usings set (its template doesn't include
       System.IO/System.Net.Http the way the WinForms/console one does); restore them
       explicitly rather than hunting down every file that relied on them. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Microsoft.Data.Sqlite 10.0.0 pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively, which
         carries NU1903 (GHSA-2m69-gcr7-jv3q — bundled SQLite native vuln, affected <= 2.1.11).
         Pin the bundle forward to a post-2.1.11 build (bundles patched SQLite) to clear it. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="Stateless" Version="5.20.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VRChat.OSCQuery" Version="0.0.7" Condition="'$(IncludeHomeAssistant)'=='true'" />
    <PackageReference Include="LucHeart.CoreOSC" Version="1.6.0" Condition="'$(IncludeHomeAssistant)'=='true'" />
  </ItemGroup>

  <!-- The test project lives under tests/ inside this project dir (this dir is its own git
       repo). The SDK's default **/*.cs glob would otherwise pull the test sources into the
       main assembly — exclude them. The test project compiles them itself. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <!-- The test project calls a few internal members (SessionOrchestrator.BuildStateMachine, the
       managers' TickForTestAsync). internal is invisible across assemblies without this — the SDK
       turns this item into the InternalsVisibleTo assembly attribute. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VrSessionMonitor.Tests" />
  </ItemGroup>

</Project>